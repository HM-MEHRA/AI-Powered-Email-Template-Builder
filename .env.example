WATCHPACK_POLLING=true
CHOKIDAR_USEPOLLING=true
REACT_APP_API_BASE_URL=http://127.0.0.1:8000/api
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-this-for-production
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DRF_ANON_THROTTLE_RATE=40/min
DRF_USER_THROTTLE_RATE=180/min
USE_OLLAMA_ONLY=true
OLLAMA_MODEL=llama3.2
OLLAMA_URL=http://127.0.0.1:11434/api/generate
OLLAMA_TIMEOUT=60
FRONTEND_URL=http://127.0.0.1:3000

# SMTP for password reset emails.
# Gmail example: use an App Password, not your normal Gmail password.
PASSWORD_RESET_EMAIL_ENABLED=false
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_gmail_app_password
DEFAULT_FROM_EMAIL=your_email@gmail.com
